{
  "name": "subaspedia",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "go": "bash scripts/dev-mobile.sh wifi",
    "go:cable": "bash scripts/dev-mobile.sh cable",
    "go:mobile": "pnpm --filter @subaspedia/mobile go",
    "go:tunnel": "pnpm go:mobile --tunnel",
    "start": "pnpm --filter @subaspedia/mobile start",
    "android": "pnpm --filter @subaspedia/mobile android",
    "ios": "pnpm --filter @subaspedia/mobile ios",
    "web": "pnpm --filter @subaspedia/mobile web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "sst": "pnpm --filter @subaspedia/infra run",
    "eas": "pnpm --filter @subaspedia/mobile exec eas",
    "wrangler": "pnpm --filter @subaspedia/api exec wrangler",
    "db": "pnpm --filter @subaspedia/api run",
    "rnr": "cd apps/mobile && pnpx @react-native-reusables/cli@latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "lefthook": "^2.1.6",
    "sst": "^4.0.0",
    "turbo": "^2.9.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
