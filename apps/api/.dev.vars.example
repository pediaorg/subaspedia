JWT_SECRET="dev-secret-change-me"

# Opcional en desarrollo: si no se define, el código de verificación se imprime
# por consola en lugar de enviarse por email (ver src/lib/email.ts).

RESEND_API_KEY=""

# Origen de la app web (para los links de los mails, ej. /logout). En prod/preview
# lo inyecta SST por stage; en dev local apuntá a tu Expo web (puerto 8081).
WEB_ORIGIN="http://localhost:8081"
